# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log
/tmp

# Ignore uploaded files in development
/storage

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore master key for credentials.
/config/master.key

# Ignore gemfiles generated by gem-release
*.gem

# Ignore built gems
/pkg

# Ignore Mac files
.DS_Store

# Ignore rspec files
.rspec_status
spec/examples.txt

# Ignore vim swap files
*~
*.swp 